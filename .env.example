# Copy to .env for local development (.env is git-ignored). Never commit real values.
# In production, set these in Railway -> service -> Variables.

# Supabase -> Project "Task" -> Connect -> "Session pooler" connection string (IPv4).
# Leave empty to use a temporary in-memory SQLite database.
DATABASE_URL=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: comma-separated free models, tried in order when one is rate-limited.
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free,baidu/ernie-5.5-flash-preview:free
